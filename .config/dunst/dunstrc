[global]
    monitor = 0
    follow = mouse
    width = 320
    height = 100
    origin = top-right
    offset = 12x40
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#272733" # @concept:surface1
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    corner_radius = 12
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#101014" # @concept:base
    foreground = "#a3a3b0" # @concept:subtext
    timeout = 5

[urgency_normal]
    background = "#101014" # @concept:base
    foreground = "#e8e8ec" # @concept:text
    timeout = 8

[urgency_critical]
    background = "#101014" # @concept:base
    foreground = "#f0645c" # @concept:red
    frame_color = "#f0645c" # @concept:red
    timeout = 0
